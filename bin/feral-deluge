#!/usr/bin/env bash
# Build and run Jerry's own Deluge 1.3.15 runtime in a Feral shared slot.
# The provider-managed Deluge and ~/.config/deluge are never modified.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly HOME_DIR="${HOME:?HOME is not set}"
REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly REPO_DIR
readonly BUILDER="${REPO_DIR}/lib/components/deluge/build-runtime-feral.sh"
readonly RUNTIME="${HOME_DIR}/.local/opt/deluge-1.3.15-jerry"
readonly CONFIG_DIR="${HOME_DIR}/.config/deluge-jerry"
readonly DATA_DIR="${HOME_DIR}/private/deluge-jerry"
readonly SOURCE_CONFIG="${HOME_DIR}/.config/deluge"
readonly CORE_FILE="${CONFIG_DIR}/core.conf"
readonly WEB_FILE="${CONFIG_DIR}/web.conf"
readonly AUTH_FILE="${CONFIG_DIR}/auth"
readonly PID_FILE="${CONFIG_DIR}/deluged.pid"
readonly WEB_PID_FILE="${CONFIG_DIR}/deluge-web.pid"
readonly WEB_BASE="/${HOME_DIR##*/}/deluge2"
readonly LOG_FILE="${CONFIG_DIR}/deluged.log"
readonly WEB_LOG_FILE="${CONFIG_DIR}/deluge-web.log"
readonly MARKER="${CONFIG_DIR}/.jerry-feral-deluge"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
warn() { printf 'Warning: %s\n' "$*" >&2; }
require_nonroot() { [[ "$(id -u)" -ne 0 ]] || die "Run as your normal Feral user, never root/sudo."; }

require_tools() {
  local tool
  for tool in bash python2 mkdir chmod cp mv rm od tr hostname ps shuf tail sleep awk curl sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || die "Required command not found: $tool"
  done
}

runtime_env() {
  env -u PYTHONHOME -u PYTHONPATH PYTHONNOUSERSITE=1 \
    LD_LIBRARY_PATH="${RUNTIME}/lib:${RUNTIME}/openssl/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$@"
}

check_runtime() {
  [[ -x "${RUNTIME}/bin/python2.7" && -x "${RUNTIME}/bin/deluged" && -x "${RUNTIME}/bin/deluge-web" ]] ||
    die "Jerry's private runtime is not installed. Run: bash ${REPO_DIR}/bin/feral-deluge install"
  SEEDBOX_DE_PREFIX="${RUNTIME}" runtime_env "${RUNTIME}/bin/python2.7" -s "${REPO_DIR}/lib/components/deluge/runtime-check.py"
}

validate_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535)) ||
    die "Port must be an integer from 1024 to 65535: $1"
}

port_is_free() {
  python2 - "$1" <<'PY'
import socket, sys
port = int(sys.argv[1])
for kind in (socket.SOCK_STREAM, socket.SOCK_DGRAM):
    sock = socket.socket(socket.AF_INET, kind)
    try:
        sock.bind(("", port))
    except socket.error:
        sys.exit(1)
    finally:
        sock.close()
PY
}

choose_port() {
  local low="$1" high="$2" attempt candidate
  for ((attempt=0; attempt<100; attempt++)); do
    candidate="$(shuf -i "${low}-${high}" -n 1)" || continue
    if port_is_free "$candidate"; then printf '%s\n' "$candidate"; return 0; fi
  done
  return 1
}

read_core_value() {
  "${RUNTIME}/bin/python2.7" - "$CORE_FILE" "$1" <<'PY'
import json, sys
def load_config(path):
    with open(path, "r") as stream:
        data = stream.read().lstrip()
    decoder = json.JSONDecoder()
    header, end = decoder.raw_decode(data)
    if isinstance(header, dict) and "file" in header:
        return json.loads(data[end:].lstrip())
    return json.loads(data)
config = load_config(sys.argv[1])
print(config.get(sys.argv[2], ""))
PY
}

profile_is_ours() {
  [[ -f "$MARKER" && ! -L "$MARKER" && -d "$CONFIG_DIR" && ! -L "$CONFIG_DIR" ]]
}

pid_is_ours() {
  local pid="$1" pattern="$2" args
  [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
  args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  [[ "$args" == *"$pattern"* && "$args" == *"$CONFIG_DIR"* ]]
}

find_ours_web_pid() {
  local pid args
  # Find the real WebUI process by its private runtime and config path.
  while IFS=' ' read -r pid args; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if [[ "$args" == *"${RUNTIME}/bin/deluge-web"* && "$args" == *"$CONFIG_DIR"* ]]; then
      printf '%s\n' "$pid"
      return 0
    fi
  done < <(ps -eo pid=,args= 2>/dev/null)
  return 1
}

get_pid() {
  local file="$1" pattern="$2" pid
  [[ -f "$file" && ! -L "$file" ]] || return 1
  # Deluge 1.3 writes its PID file as "PID;PORT", not just "PID".
  IFS=';' read -r pid _ < "$file" || true
  pid_is_ours "$pid" "$pattern" || return 1
  printf '%s\n' "$pid"
}

start_daemon() {
  local pid rpc_port hostlist_state web_was_running=""
  profile_is_ours || die "No managed profile found. Run install first."
  hostlist_state="$(sync_hostlist)"
  if [[ "$hostlist_state" == "changed" ]] && { web_was_running="$(get_pid "$WEB_PID_FILE" deluge-web)" || web_was_running="$(find_ours_web_pid)" || true; } && [[ -n "$web_was_running" ]]; then
    info "Jerry RPC host entry was corrected; restarting only Jerry WebUI to reload it."
    stop_one "$WEB_PID_FILE" deluge-web
  fi
  if pid="$(get_pid "$PID_FILE" deluged)"; then info "Jerry deluged already running (PID $pid)."; else
    rm -f -- "$PID_FILE"
    rpc_port="$(read_core_value daemon_port)"
    validate_port "$rpc_port"
    info "Starting Jerry's private Deluge daemon (RPC $rpc_port)..."
    # Explicitly detach from SSH so the private daemon survives logout.
    nohup env -u PYTHONHOME -u PYTHONPATH PYTHONNOUSERSITE=1 \
      LD_LIBRARY_PATH="${RUNTIME}/lib:${RUNTIME}/openssl/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
      "${RUNTIME}/bin/deluged" -c "$CONFIG_DIR" -p "$rpc_port" -P "$PID_FILE" \
      -L info -l "$LOG_FILE" >/dev/null 2>&1 </dev/null
    local attempt
    for ((attempt=0; attempt<15; attempt++)); do
      if pid="$(get_pid "$PID_FILE" deluged)"; then break; fi
      sleep 1
    done
    [[ -n "${pid:-}" ]] || { tail -n 50 "$LOG_FILE" 2>/dev/null || true; die "Private deluged did not start."; }
  fi

  if pid="$(get_pid "$WEB_PID_FILE" deluge-web)"; then
    info "Jerry WebUI already running (PID $pid)."
  elif pid="$(find_ours_web_pid)"; then
    # Recover from a previous launch where Deluge forked and the wrapper PID
    # was recorded instead of the actual WebUI PID.
    printf '%s\n' "$pid" > "$WEB_PID_FILE"
    info "Jerry WebUI already running (PID $pid; recovered PID file)."
  else
    rm -f -- "$WEB_PID_FILE"
    local web_port attempt
    web_port="$(read_web_port)"
    info "Starting Jerry's private WebUI on port $web_port..."
    # Do not pass -f/--fork: keep the real WebUI process manageable via $!.
    # Keep the WebUI alive after SSH logout; use a separate launcher log to avoid two writers.
    nohup env -u PYTHONHOME -u PYTHONPATH PYTHONNOUSERSITE=1 \
      LD_LIBRARY_PATH="${RUNTIME}/lib:${RUNTIME}/openssl/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
      "${RUNTIME}/bin/deluge-web" -c "$CONFIG_DIR" -p "$web_port" -b "$WEB_BASE" \
      -L info -l "$WEB_LOG_FILE" >>"$CONFIG_DIR/deluge-web-launch.log" 2>&1 </dev/null &
    pid=""
    for ((attempt=0; attempt<10; attempt++)); do
      if pid="$(find_ours_web_pid)"; then break; fi
      sleep 1
    done
    if [[ -z "$pid" ]] || ! pid_is_ours "$pid" deluge-web; then
      rm -f -- "$WEB_PID_FILE"
      tail -n 50 "$WEB_LOG_FILE" 2>/dev/null || true
      die "Private WebUI did not stay running."
    fi
    printf '%s\n' "$pid" > "$WEB_PID_FILE"
  fi
  info "Jerry's Deluge instance is running separately from the provider instance."
}

sync_hostlist() {
  # Deluge 1.3.15 stores Connection Manager entries in hostlist.conf.1.2.
  # Synchronize only Jerry's private hostlist and WebUI config.
  "${RUNTIME}/bin/python2.7" - "${CONFIG_DIR}" "$(read_core_value daemon_port)" <<'PY'
import hashlib
import json
import os
import tempfile
import sys

config_dir = sys.argv[1]
port = int(sys.argv[2])

def load(path, default):
    if not os.path.exists(path):
        return default
    with open(path, "r") as stream:
        raw = stream.read().lstrip()
    decoder = json.JSONDecoder()
    header, end = decoder.raw_decode(raw)
    if isinstance(header, dict) and "file" in header:
        return json.loads(raw[end:].lstrip())
    return header

def save(path, config, header):
    fd, tmp = tempfile.mkstemp(prefix=".jerry-config.", dir=config_dir)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(json.dumps(header) + "\\n")
            json.dump(config, stream, sort_keys=True, indent=2)
            stream.write("\\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.rename(tmp, path)
        os.chmod(path, 0600)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

host_path = os.path.join(config_dir, "hostlist.conf.1.2")
host_header = {"file": 1, "format": 1}
host_config = load(host_path, {"hosts": []})
hosts = host_config.get("hosts", [])
host = None
for item in hosts:
    if len(item) >= 3 and item[1] in ("127.0.0.1", "localhost"):
        host = item
        break
changed = False
if host is None:
    host_id = hashlib.sha1(("jerry-localhost:%s" % port).encode("utf-8")).hexdigest()
    hosts.insert(0, [host_id, "127.0.0.1", port, "", ""])
    changed = True
elif host[1] != "127.0.0.1" or int(host[2]) != port:
    host[1], host[2] = "127.0.0.1", port
    changed = True
host_config["hosts"] = hosts
if changed or not os.path.exists(host_path):
    save(host_path, host_config, host_header)

web_path = os.path.join(config_dir, "web.conf")
web_config = load(web_path, {})
web_changed = web_config.get("default_daemon") != "127.0.0.1:%s" % port or web_config.get("daemon") != ["127.0.0.1:%s" % port]
web_config["default_daemon"] = "127.0.0.1:%s" % port
web_config["daemon"] = ["127.0.0.1:%s" % port]
if web_changed or not os.path.exists(web_path):
    save(web_path, web_config, {"file": 1})
print("changed" if changed or web_changed else "unchanged")
PY
}

read_web_port() {
  "${RUNTIME}/bin/python2.7" - "$WEB_FILE" <<'PY'
import json, sys
def load_config(path):
    with open(path, "r") as stream:
        data = stream.read().lstrip()
    decoder = json.JSONDecoder()
    header, end = decoder.raw_decode(data)
    if isinstance(header, dict) and "file" in header:
        return json.loads(data[end:].lstrip())
    return json.loads(data)
config = load_config(sys.argv[1])
print(config.get("port", 8112))
PY
}

stop_one() {
  local file="$1" pattern="$2" pid attempt
  if ! pid="$(get_pid "$file" "$pattern")"; then
    if [[ "$pattern" == "deluge-web" ]] && pid="$(find_ours_web_pid)"; then
      printf '%s\n' "$pid" > "$file"
    else
      rm -f -- "$file"
      return 0
    fi
  fi
  info "Stopping managed $pattern (PID $pid)..."
  kill -TERM "$pid"
  for ((attempt=0; attempt<15; attempt++)); do
    if ! kill -0 "$pid" 2>/dev/null || ! pid_is_ours "$pid" "$pattern"; then rm -f -- "$file"; return 0; fi
    sleep 1
  done
  die "$pattern did not stop cleanly; no force kill attempted."
}

install_profile() {
  local rpc_port="" incoming_port="" web_port="" source_rpc
  JOBS=1
  while (($#)); do
    case "$1" in
      --rpc-port) (($# >= 2)) || die "Missing --rpc-port value"; rpc_port="$2"; shift 2 ;;
      --incoming-port) (($# >= 2)) || die "Missing --incoming-port value"; incoming_port="$2"; shift 2 ;;
      --web-port) (($# >= 2)) || die "Missing --web-port value"; web_port="$2"; shift 2 ;;
      --jobs) (($# >= 2)) || die "Missing --jobs value"; JOBS="$2"; shift 2 ;;
      *) die "Unknown install option: $1" ;;
    esac
  done
  require_nonroot
  require_tools
  [[ -f "${REPO_DIR}/lib/components/deluge/sources.lock" && -f "${REPO_DIR}/lib/components/deluge/patches.lock" ]] ||
    die "Repository checkout is incomplete. Clone the full race-in/jerry-custom-setup repository."
  [[ -f "${BUILDER}" && -f "${REPO_DIR}/lib/components/deluge/libtorrent-1.1.14.patch" ]] ||
    die "Rootless builder or patch file missing from this checkout."
  [[ -f "${SOURCE_CONFIG}/core.conf" && ! -L "${SOURCE_CONFIG}/core.conf" ]] ||
    die "Provider Deluge core.conf not found. Install Deluge 1.3.15 from Feral's manager first."

  if [[ ! -x "${RUNTIME}/bin/deluged" ]]; then
    info "Building Jerry's separate Deluge 1.3.15 + Python 2.7.18 + patched libtorrent 1.1.14 runtime under ${RUNTIME}."
    info "This requires a working compiler/toolchain and development headers on the shared slot; no sudo/apt is used."
    bash "$BUILDER" --jobs "${JOBS:-2}"
  fi
  check_runtime

  if [[ -e "$CONFIG_DIR" ]]; then
    if profile_is_ours; then
      info "Managed Jerry profile already exists."
      start_daemon
      show_connection
      return 0
    fi
    [[ -d "$CONFIG_DIR" && ! -L "$CONFIG_DIR" ]] || die "$CONFIG_DIR exists but is not a safe directory; refusing to overwrite."
    local entry name
    for entry in "$CONFIG_DIR"/* "$CONFIG_DIR"/.[!.]*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      name="${entry##*/}"
      case "$name" in
        core.conf|web.conf|plugins) ;;
        *) die "Incomplete profile contains unexpected entry '$name'; refusing to remove it." ;;
      esac
      [[ ! -L "$entry" ]] || die "Incomplete profile entry '$name' is a symlink; refusing to remove it."
    done
    [[ -f "$CORE_FILE" && -f "$WEB_FILE" && -d "$CONFIG_DIR/plugins" ]] || die "Incomplete profile layout is not recognized; refusing to remove it."
    warn "Removing only the recognized incomplete Jerry config from the earlier failed setup; runtime and download data will be kept."
    rm -rf -- "$CONFIG_DIR"
  fi

  source_rpc="$( "${RUNTIME}/bin/python2.7" - "$SOURCE_CONFIG/core.conf" <<'PY'
import json, sys
def load_config(path):
    with open(path, "r") as stream:
        data = stream.read().lstrip()
    decoder = json.JSONDecoder()
    header, end = decoder.raw_decode(data)
    if isinstance(header, dict) and "file" in header:
        return json.loads(data[end:].lstrip())
    return json.loads(data)
config = load_config(sys.argv[1])
print(config.get("daemon_port", 58846))
PY
)"
  [[ "$rpc_port" != "$source_rpc" ]] || die "Jerry RPC port must differ from the provider Deluge RPC port ($source_rpc)."
  [[ -n "$rpc_port" ]] || rpc_port="$(choose_port 20000 32000)" || die "Could not find a free RPC port."
  [[ -n "$incoming_port" ]] || incoming_port="$(choose_port 40000 60000)" || die "Could not find a free incoming port."
  [[ -n "$web_port" ]] || web_port="$(choose_port 32001 39000)" || die "Could not find a free WebUI port."
  validate_port "$rpc_port"; validate_port "$incoming_port"; validate_port "$web_port"
  [[ "$rpc_port" != "$incoming_port" && "$rpc_port" != "$web_port" && "$incoming_port" != "$web_port" ]] ||
    die "RPC, incoming, and WebUI ports must all be different."
  port_is_free "$rpc_port" || die "RPC port $rpc_port is already in use."
  port_is_free "$incoming_port" || die "Incoming port $incoming_port is already in use."
  port_is_free "$web_port" || die "WebUI port $web_port is already in use."

  mkdir -p -- "$CONFIG_DIR" "$DATA_DIR/data" "$DATA_DIR/watch" "$DATA_DIR/torrents" "$DATA_DIR/completed" "$CONFIG_DIR/plugins"
  chmod 700 "$CONFIG_DIR" "$DATA_DIR" "$DATA_DIR/data" "$DATA_DIR/watch" "$DATA_DIR/torrents" "$DATA_DIR/completed" "$CONFIG_DIR/plugins"
  cp -- "$SOURCE_CONFIG/core.conf" "$CORE_FILE"
  if [[ -f "$SOURCE_CONFIG/web.conf" && ! -L "$SOURCE_CONFIG/web.conf" ]]; then cp -- "$SOURCE_CONFIG/web.conf" "$WEB_FILE"; else printf '{}\n' > "$WEB_FILE"; fi
  chmod 600 "$CORE_FILE" "$WEB_FILE"

  SEEDBOX_FERAL_CONFIG_DIR="$CONFIG_DIR" SEEDBOX_FERAL_DATA_DIR="$DATA_DIR" \
  SEEDBOX_FERAL_RPC_PORT="$rpc_port" SEEDBOX_FERAL_INCOMING_PORT="$incoming_port" \
  SEEDBOX_FERAL_WEB_PORT="$web_port" "${RUNTIME}/bin/python2.7" - <<'PY'
import json, os, tempfile
config_dir = os.environ["SEEDBOX_FERAL_CONFIG_DIR"]
data = os.environ["SEEDBOX_FERAL_DATA_DIR"]
rpc = int(os.environ["SEEDBOX_FERAL_RPC_PORT"])
incoming = int(os.environ["SEEDBOX_FERAL_INCOMING_PORT"])
web = int(os.environ["SEEDBOX_FERAL_WEB_PORT"])
def load(path):
    with open(path, "r") as stream:
        data = stream.read().lstrip()
    decoder = json.JSONDecoder()
    header, end = decoder.raw_decode(data)
    if isinstance(header, dict) and "file" in header:
        return json.loads(data[end:].lstrip())
    return json.loads(data)
def atomic(path, config):
    fd, tmp = tempfile.mkstemp(prefix=".config.", dir=config_dir)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(json.dumps({"file": 1}) + "\n")
            json.dump(config, stream, sort_keys=True, indent=2)
            stream.write("\n")
            stream.flush(); os.fsync(stream.fileno())
        os.rename(tmp, path)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        raise
core_path = os.path.join(config_dir, "core.conf")
core = load(core_path)
core.update({
    "daemon_port": rpc, "allow_remote": True, "random_port": False,
    "listen_ports": [incoming, incoming],
    "download_location": os.path.join(data, "data") + "/",
    "autoadd_location": os.path.join(data, "watch") + "/",
    "torrentfiles_location": os.path.join(data, "torrents") + "/",
    "plugins_location": os.path.join(config_dir, "plugins"),
    "state_location": os.path.join(config_dir, "state"),
    "move_completed": False,
    "move_completed_path": os.path.join(data, "completed") + "/",
})
atomic(core_path, core)
web_path = os.path.join(config_dir, "web.conf")
webcfg = load(web_path)
webcfg["port"] = web
webcfg["default_daemon"] = "127.0.0.1:%s" % rpc
webcfg["daemon"] = ["127.0.0.1:%s" % rpc]
atomic(web_path, webcfg)
PY

  local rpc_password web_password salt
  rpc_password="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  web_password="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
  salt="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n' | sha256sum | awk '{print $1}')"
  salt="$(printf '%s' "$salt" | sha1sum | awk '{print $1}')"
  [[ "${#rpc_password}" -eq 64 && "${#web_password}" -eq 48 && "${#salt}" -eq 40 ]] || die "Secure credential generation failed."
  printf '%s:%s:10\n' "$(id -un)" "$rpc_password" > "$AUTH_FILE"
  chmod 600 "$AUTH_FILE"
  SEEDBOX_FERAL_WEB_PASSWORD="$web_password" SEEDBOX_FERAL_WEB_SALT="$salt" "${RUNTIME}/bin/python2.7" - "$WEB_FILE" <<'PY'
import hashlib, json, os, sys, tempfile
path = sys.argv[1]
with open(path, "r") as stream:
    data = stream.read().lstrip()
decoder = json.JSONDecoder()
header, end = decoder.raw_decode(data)
if isinstance(header, dict) and "file" in header:
    cfg = json.loads(data[end:].lstrip())
else:
    cfg = json.loads(data)
salt = os.environ["SEEDBOX_FERAL_WEB_SALT"]
password = os.environ["SEEDBOX_FERAL_WEB_PASSWORD"]
cfg["pwd_salt"] = salt
cfg["pwd_sha1"] = hashlib.sha1((salt + password).encode("utf-8")).hexdigest()
fd, tmp = tempfile.mkstemp(prefix=".web.", dir=os.path.dirname(path))
with os.fdopen(fd, "w") as stream:
    stream.write(json.dumps({"file": 1}) + "\n")
    json.dump(cfg, stream, sort_keys=True, indent=2)
    stream.write("\n")
    stream.flush(); os.fsync(stream.fileno())
os.rename(tmp, path)
PY
  printf 'profile=jerry-feral-deluge\nrpc_port=%s\nincoming_port=%s\nweb_port=%s\n' "$rpc_port" "$incoming_port" "$web_port" > "$MARKER"
  chmod 600 "$MARKER"
  start_daemon
  printf '\nJerry private WebUI: http://%s:%s/\n' "$(hostname -f 2>/dev/null || hostname)" "$web_port"
  printf 'WebUI password: %s\n' "$web_password"
  printf 'RPC username: %s\nRPC password: %s\nRPC port: %s\nIncoming port: %s\n' "$(id -un)" "$rpc_password" "$rpc_port" "$incoming_port"
  printf 'If Feral blocks direct port access, use an SSH tunnel or ask Feral support about allowed ports. Keep these credentials private.\n'
}

show_connection() {
  profile_is_ours || die "No managed Jerry profile found."
  local web_port rpc_port
  web_port="$(read_web_port)"
  rpc_port="$(read_core_value daemon_port)"
  printf 'WebUI: http://%s:%s/\n' "$(hostname -f 2>/dev/null || hostname)" "$web_port"
  printf 'RPC port: %s\n' "$rpc_port"
  local rpc_user rpc_password
  rpc_user="$(id -un)"
  rpc_password="$(awk -F: -v user="$rpc_user" '$1 == user {print $2; exit}' "$AUTH_FILE")"
  printf 'RPC username: %s\nRPC password: %s\n' "$rpc_user" "$rpc_password"
  printf 'Add 127.0.0.1:%s in the WebUI Connection Manager and use these RPC credentials.\n' "$rpc_port"
  printf 'WebUI config: %s/web.conf (WebUI password is shown only during install)\n' "$CONFIG_DIR"
}

show_status() {
  profile_is_ours || die "No managed Jerry profile found."
  local daemon_pid web_pid
  if daemon_pid="$(get_pid "$PID_FILE" deluged)"; then info "Jerry daemon: running (PID $daemon_pid)"; else info "Jerry daemon: stopped"; fi
  if web_pid="$(get_pid "$WEB_PID_FILE" deluge-web)" || web_pid="$(find_ours_web_pid)"; then
    printf '%s\n' "$web_pid" > "$WEB_PID_FILE"
    info "Jerry WebUI: running (PID $web_pid; port $(read_web_port))"
  else
    info "Jerry WebUI: stopped"
  fi
  info "Provider config and process are separate and untouched."
}

reset_web_password() {
  profile_is_ours || die "No managed Jerry profile found."
  info "Stopping only Jerry's WebUI before changing its password..."
  stop_one "$WEB_PID_FILE" deluge-web

  local rc=0
  runtime_env "${RUNTIME}/bin/python2.7" - <<'PY' || rc=$?
import getpass
import hashlib
import os
import random
import sys
from deluge.configmanager import set_config_dir, ConfigManager
from deluge.common import utf8_encoded

set_config_dir(os.path.expanduser("~/.config/deluge-jerry"))
config = ConfigManager("web.conf")
password = getpass.getpass("New Jerry WebUI password: ")
confirm = getpass.getpass("Confirm new password: ")
if not password:
    print("ERROR: Password cannot be empty.")
    sys.exit(1)
if password != confirm:
    print("ERROR: Passwords do not match.")
    sys.exit(1)
salt = hashlib.sha1(str(random.getrandbits(40))).hexdigest()
digest = hashlib.sha1(salt)
digest.update(utf8_encoded(password))
config["pwd_salt"] = salt
config["pwd_sha1"] = digest.hexdigest()
for key in ("pwd_md5", "old_pwd_md5", "old_pwd_salt"):
    if key in config.config:
        del config.config[key]
if not config.save():
    print("ERROR: Could not save web.conf.")
    sys.exit(1)
print("Password saved using Deluge 1.3.15's native SHA-1 scheme.")
PY
  if ((rc != 0)); then
    warn "Password reset failed; attempting to bring Jerry services back up."
    start_daemon || true
    return "$rc"
  fi

  start_daemon
  info "Jerry WebUI password reset complete."
}

uninstall_profile() {
  local purge=0 yes=0 arg
  for arg in "$@"; do case "$arg" in --purge-data) purge=1 ;; --yes) yes=1 ;; *) die "Unknown uninstall option: $arg" ;; esac; done
  require_nonroot
  profile_is_ours || die "No managed Jerry profile found; refusing to remove an unmanaged path."
  (( ! purge || yes )) || die "--purge-data requires --yes."
  stop_one "$WEB_PID_FILE" deluge-web
  stop_one "$PID_FILE" deluged
  rm -rf -- "$CONFIG_DIR"
  if ((purge)); then
    [[ "$DATA_DIR" == "$HOME_DIR/private/deluge-jerry" && ! -L "$DATA_DIR" ]] || die "Unsafe data path; refusing to purge."
    rm -rf -- "$DATA_DIR"
  else
    info "Download data retained at $DATA_DIR"
  fi
  info "Removed Jerry's private profile. Provider Deluge was not changed."
}

usage() {
  cat <<'USAGE'
Jerry Deluge 1.3.15 for Feral shared slots (separate private runtime)

Usage:
  bash bin/feral-deluge install [--jobs N] [--rpc-port PORT] [--incoming-port PORT] [--web-port PORT]
  bash bin/feral-deluge start|stop|restart|status|connection
  bash bin/feral-deluge reset-password
  bash bin/feral-deluge uninstall [--purge-data --yes]

This builds Jerry's Python 2.7.18 + OpenSSL 1.1.1w + patched libtorrent 1.1.14
and Deluge 1.3.15 under ~/.local/opt, without sudo/apt/systemd. It requires
working build tools/development headers on the shared host. It creates separate
config/data/ports and never replaces the provider-managed Deluge. A successful
build is not guaranteed if Feral restricts compilers or development headers.
USAGE
}

main() {
  local action="${1:-help}"
  [[ $# -eq 0 ]] || shift
  case "$action" in
    install) install_profile "$@" ;;
    start) require_nonroot; check_runtime; start_daemon ;;
    stop) require_nonroot; stop_one "$WEB_PID_FILE" deluge-web; stop_one "$PID_FILE" deluged ;;
    restart) require_nonroot; check_runtime; stop_one "$WEB_PID_FILE" deluge-web; stop_one "$PID_FILE" deluged; start_daemon ;;
    status) require_nonroot; show_status ;;
    connection) require_nonroot; show_connection ;;
    reset-password) require_nonroot; check_runtime; reset_web_password ;;
    uninstall) uninstall_profile "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "Unknown command: $action" ;;
  esac
}
main "$@"
