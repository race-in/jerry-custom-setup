#!/usr/bin/env bash
# Feral/shared-slot Deluge helper. Reuses the provider-installed Deluge 1.3.15;
# never uses sudo, APT, systemd, /opt, or /var.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly HOME_DIR="${HOME:?HOME is not set}"
readonly CONFIG_DIR="${HOME_DIR}/.config/deluge-jerry"
readonly DATA_DIR="${HOME_DIR}/private/deluge-jerry"
readonly SOURCE_CORE="${HOME_DIR}/.config/deluge/core.conf"
readonly AUTH_FILE="${CONFIG_DIR}/auth"
readonly PID_FILE="${CONFIG_DIR}/deluged.pid"
readonly LOG_FILE="${CONFIG_DIR}/deluged.log"
readonly MARKER="${CONFIG_DIR}/.jerry-feral-deluge"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
warn() { printf 'Warning: %s\n' "$*" >&2; }

require_nonroot() {
  [[ "$(id -u)" -ne 0 ]] || die "Do not run this shared-slot helper as root or with sudo."
}

require_tools() {
  local tool
  for tool in python2 deluged mkdir chmod cp mv rm od tr hostname ps shuf tail sleep awk; do
    command -v "$tool" >/dev/null 2>&1 || die "Required command not found: $tool"
  done
}

check_provider_runtime() {
  local py_version deluge_version lt_version
  py_version="$(python2 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)" ||
    die "Python 2 is unavailable. Install Deluge from the Feral web manager first."
  [[ "$py_version" == "2.7" ]] || die "Expected Python 2.7, found Python $py_version."
  deluge_version="$(python2 -c 'import deluge; print(getattr(deluge, "__version__", ""))' 2>/dev/null)" ||
    die "Python 2 cannot import Deluge. Install Deluge from the Feral web manager first."
  [[ "$deluge_version" == "1.3.15" ]] ||
    die "This Feral mode supports the provider's Deluge 1.3.15 only; detected '$deluge_version'."
  lt_version="$(python2 -c 'import libtorrent; print(getattr(libtorrent, "version", "unknown"))' 2>/dev/null)" ||
    die "Python 2 cannot import libtorrent; keep the provider-managed Deluge installation."
  [[ "$lt_version" == 1.* ]] || die "Expected a libtorrent 1.x runtime, found '$lt_version'."
  info "Detected provider runtime: Deluge $deluge_version / libtorrent $lt_version"
}

read_core_value() {
  local key="$1"
  python2 - "$SOURCE_CORE" "$key" <<'PY'
import json
import sys

path, key = sys.argv[1:3]
with open(path, "r") as stream:
    lines = stream.readlines()
if len(lines) < 2:
    raise SystemExit("Invalid Deluge core.conf framing")
try:
    config = json.loads("".join(lines[1:]))
except Exception as exc:
    raise SystemExit("Cannot parse Deluge core.conf: %s" % exc)
value = config.get(key, "")
if isinstance(value, (list, tuple)):
    value = ",".join(str(item) for item in value)
print(value)
PY
}

port_is_free() {
  python2 - "$1" <<'PY'
import socket
import sys
port = int(sys.argv[1])
sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    sock.bind(("", port))
except socket.error:
    raise SystemExit(1)
finally:
    sock.close()
PY
}

choose_port() {
  local low="$1" high="$2" attempt candidate
  for attempt in {1..80}; do
    candidate="$(shuf -i "${low}-${high}" -n 1)" || continue
    if port_is_free "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

validate_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535)) ||
    die "Port must be an integer from 1024 to 65535: $1"
}

profile_is_ours() {
  [[ -f "$MARKER" && ! -L "$MARKER" && -d "$CONFIG_DIR" && ! -L "$CONFIG_DIR" ]]
}

read_rpc_port() {
  read_core_value daemon_port
}

pid_is_ours() {
  local pid="$1" args
  [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
  args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  [[ "$args" == *deluged* && "$args" == *"$CONFIG_DIR"* ]]
}

get_pid() {
  [[ -f "$PID_FILE" && ! -L "$PID_FILE" ]] || return 1
  local pid
  IFS= read -r pid < "$PID_FILE" || true
  pid_is_ours "$pid" || return 1
  printf '%s\n' "$pid"
}

start_daemon() {
  local pid
  profile_is_ours || die "No managed Feral profile found. Run: $0 install"
  if pid="$(get_pid)"; then
    info "Deluge is already running (PID $pid)."
    return 0
  fi
  rm -f -- "$PID_FILE"
  local rpc_port
  rpc_port="$(read_rpc_port)"
  validate_port "$rpc_port"
  info "Starting the separate Deluge daemon on RPC port $rpc_port..."
  deluged -c "$CONFIG_DIR" -p "$rpc_port" -P "$PID_FILE" -L info -l "$LOG_FILE"
  local attempt
  for attempt in {1..12}; do
    if pid="$(get_pid)"; then
      info "Deluge started (PID $pid). Log: $LOG_FILE"
      return 0
    fi
    sleep 1
  done
  warn "The daemon did not become ready. Recent log output:"
  tail -n 40 "$LOG_FILE" 2>/dev/null || true
  return 1
}

stop_daemon() {
  local pid attempt
  if ! pid="$(get_pid)"; then
    rm -f -- "$PID_FILE"
    info "The managed Deluge daemon is not running."
    return 0
  fi
  info "Stopping Deluge PID $pid..."
  kill -TERM "$pid"
  for attempt in {1..12}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f -- "$PID_FILE"
      info "Deluge stopped."
      return 0
    fi
    sleep 1
  done
  die "Deluge did not stop cleanly. Review $LOG_FILE; no force kill was attempted."
}

install_profile() {
  local rpc_port="${1:-}" incoming_port="${2:-}" default_rpc
  require_nonroot
  require_tools
  check_provider_runtime
  [[ -f "$SOURCE_CORE" && ! -L "$SOURCE_CORE" ]] ||
    die "Missing $SOURCE_CORE. Install/enable Deluge in the Feral web manager first; this helper never replaces it."
  if [[ -e "$CONFIG_DIR" ]]; then
    profile_is_ours || die "$CONFIG_DIR already exists but is not a managed profile; refusing to overwrite it."
    info "The managed profile already exists."
    start_daemon
    show_connection
    return 0
  fi

  default_rpc="$(read_core_value daemon_port)"
  [[ "$default_rpc" =~ ^[0-9]+$ ]] || default_rpc=0
  if [[ -z "$rpc_port" ]]; then
    rpc_port="$(choose_port 10001 32001)" || die "Could not find a free RPC port."
  fi
  validate_port "$rpc_port"
  [[ "$rpc_port" != "$default_rpc" ]] || die "RPC port conflicts with the provider-managed Deluge daemon."
  port_is_free "$rpc_port" || die "RPC port $rpc_port is already in use."
  if [[ -z "$incoming_port" ]]; then
    incoming_port="$(choose_port 40000 60000)" || die "Could not find a free incoming port."
  fi
  validate_port "$incoming_port"
  [[ "$incoming_port" != "$rpc_port" ]] || die "RPC and incoming ports must be different."
  port_is_free "$incoming_port" || die "Incoming port $incoming_port is already in use."

  mkdir -p -- "$CONFIG_DIR" "$DATA_DIR/data" "$DATA_DIR/watch" "$DATA_DIR/torrents" "$DATA_DIR/completed" "$CONFIG_DIR/plugins"
  chmod 700 "$CONFIG_DIR" "$DATA_DIR" "$DATA_DIR/data" "$DATA_DIR/watch" "$DATA_DIR/torrents" "$DATA_DIR/completed" "$CONFIG_DIR/plugins"
  cp -- "$SOURCE_CORE" "$CONFIG_DIR/core.conf"
  chmod 600 "$CONFIG_DIR/core.conf"

  SEEDBOX_FERAL_SOURCE_CORE="$SOURCE_CORE" \
  SEEDBOX_FERAL_CONFIG_DIR="$CONFIG_DIR" \
  SEEDBOX_FERAL_DATA_DIR="$DATA_DIR" \
  SEEDBOX_FERAL_RPC_PORT="$rpc_port" \
  SEEDBOX_FERAL_INCOMING_PORT="$incoming_port" \
  python2 - <<'PY'
import json
import os
import tempfile

source = os.environ["SEEDBOX_FERAL_SOURCE_CORE"]
target = os.path.join(os.environ["SEEDBOX_FERAL_CONFIG_DIR"], "core.conf")
data = os.environ["SEEDBOX_FERAL_DATA_DIR"]
rpc_port = int(os.environ["SEEDBOX_FERAL_RPC_PORT"])
incoming_port = int(os.environ["SEEDBOX_FERAL_INCOMING_PORT"])

with open(source, "r") as stream:
    lines = stream.readlines()
if len(lines) < 2:
    raise SystemExit("Invalid source core.conf framing")
version = lines[0].strip()
config = json.loads("".join(lines[1:]))
config.update({
    "daemon_port": rpc_port,
    "allow_remote": True,
    "random_port": False,
    "listen_ports": [incoming_port, incoming_port],
    "download_location": os.path.join(data, "data") + "/",
    "state_location": os.path.join(os.environ["SEEDBOX_FERAL_CONFIG_DIR"], "state"),
    "autoadd_location": os.path.join(data, "watch") + "/",
    "torrentfiles_location": os.path.join(data, "torrents") + "/",
    "plugins_location": os.path.join(os.environ["SEEDBOX_FERAL_CONFIG_DIR"], "plugins"),
    "move_completed": False,
    "move_completed_path": os.path.join(data, "completed") + "/",
})
fd, temporary = tempfile.mkstemp(prefix=".core.conf.", dir=os.path.dirname(target))
try:
    with os.fdopen(fd, "w") as stream:
        stream.write(version + "\n")
        stream.write(json.dumps(config, sort_keys=True, indent=2) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.rename(temporary, target)
except Exception:
    try:
        os.unlink(temporary)
    except OSError:
        pass
    raise
PY

  local rpc_password
  rpc_password="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "${#rpc_password}" -eq 64 ]] || die "Could not generate a secure RPC password."
  printf '%s:%s:10\n' "$(id -un)" "$rpc_password" > "$AUTH_FILE"
  chmod 600 "$AUTH_FILE"
  printf 'profile=jerry-feral-deluge\nrpc_port=%s\nincoming_port=%s\n' "$rpc_port" "$incoming_port" > "$MARKER"
  chmod 600 "$MARKER"
  info "Created a separate user-owned profile. The provider's original ~/.config/deluge was not changed."
  start_daemon
  show_connection
}

show_connection() {
  profile_is_ours || die "No managed Feral profile found. Run: $0 install"
  local rpc_port rpc_password host
  rpc_port="$(read_rpc_port)"
  rpc_password="$(awk -F: -v user="$(id -un)" '$1 == user {print $2; exit}' "$AUTH_FILE")"
  [[ -n "$rpc_password" ]] || die "RPC credentials are missing from $AUTH_FILE."
  host="$(hostname -f 2>/dev/null || hostname)"
  printf '\nFeral thin-client connection details (keep the password private):\n'
  printf 'Host:     10.0.0.1  (or %s)\n' "$host"
  printf 'User:     %s\n' "$(id -un)"
  printf 'RPC port: %s\n' "$rpc_port"
  printf 'Password: %s\n' "$rpc_password"
  printf '\nThis is a separate daemon, not the provider WebUI instance.\n'
}

show_status() {
  profile_is_ours || die "No managed Feral profile found. Run: $0 install"
  local pid rpc_port
  rpc_port="$(read_rpc_port)"
  if pid="$(get_pid)"; then
    info "Status: running (PID $pid; RPC port $rpc_port)"
  else
    info "Status: stopped (RPC port $rpc_port)"
    return 1
  fi
}

uninstall_profile() {
  local purge_data=0 confirm=0 arg
  for arg in "$@"; do
    case "$arg" in
      --purge-data) purge_data=1 ;;
      --yes) confirm=1 ;;
      *) die "Unknown uninstall option: $arg" ;;
    esac
  done
  require_nonroot
  profile_is_ours || die "No managed Feral profile found; refusing to remove an unmanaged path."
  if ((purge_data && !confirm)); then
    die "--purge-data requires --yes."
  fi
  stop_daemon
  rm -rf -- "$CONFIG_DIR"
  if ((purge_data)); then
    [[ "$DATA_DIR" == "$HOME_DIR/private/deluge-jerry" && ! -L "$DATA_DIR" ]] || die "Unsafe data path; refusing to purge."
    rm -rf -- "$DATA_DIR"
    info "Removed the managed profile and its private data."
  else
    info "Removed the managed profile. Download data remains at $DATA_DIR."
  fi
}

usage() {
  cat <<'USAGE'
Feral/shared-slot Deluge helper (rootless; uses the provider-installed runtime)

Usage:
  feral-deluge install [--rpc-port PORT] [--incoming-port PORT]
  feral-deluge start
  feral-deluge stop
  feral-deluge restart
  feral-deluge status
  feral-deluge connection
  feral-deluge uninstall [--purge-data --yes]

Install Deluge 1.3.15 from the Feral web manager first. This helper creates a
separate Deluge daemon/profile using the existing Python 2.7 + libtorrent 1.x.
It does not compile libraries, run APT, use sudo/systemd, or alter the provider
profile at ~/.config/deluge. The extra daemon is managed manually and connects
through a Deluge 1.x thin client; it is not added to Feral's WebUI automatically.
USAGE
}

main() {
  local action="${1:-help}"
  [[ $# -eq 0 ]] || shift
  case "$action" in
    install)
      local rpc_port="" incoming_port=""
      while (($#)); do
        case "$1" in
          --rpc-port) (($# >= 2)) || die "Missing value for --rpc-port"; rpc_port="$2"; shift 2 ;;
          --incoming-port) (($# >= 2)) || die "Missing value for --incoming-port"; incoming_port="$2"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          *) die "Unknown install option: $1" ;;
        esac
      done
      install_profile "$rpc_port" "$incoming_port"
      ;;
    start) (($# == 0)) || die "start takes no options"; require_nonroot; require_tools; start_daemon ;;
    stop) (($# == 0)) || die "stop takes no options"; require_nonroot; stop_daemon ;;
    restart) (($# == 0)) || die "restart takes no options"; require_nonroot; stop_daemon; start_daemon ;;
    status) (($# == 0)) || die "status takes no options"; require_nonroot; require_tools; show_status ;;
    connection) (($# == 0)) || die "connection takes no options"; require_nonroot; show_connection ;;
    uninstall) uninstall_profile "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "Unknown command: $action" ;;
  esac
}

main "$@"
